---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import Icon from './Icon.astro';
import PixelIcon from './PixelIcon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Heading level, so cards nest correctly under the page's own headings. */
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const { title, summary, tech, status, context, repo, demo } = project.data;
const Heading = headingLevel;
const href = url(`projects/${project.id}/`);
---

<article class="card">
  <!-- "Screen" at the top of the card: a dark window with the project's type and status. -->
  <div class="screen crt" aria-hidden="true">
    <span class="bar"><i></i><i></i><i></i></span>
    <PixelIcon name="monitor" scale={4} class="glyph" />
    <span class="ctx">{context ?? 'Project'}</span>
  </div>

  <div class="body">
    <Heading class="title"><a href={href}>{title}</a></Heading>
    <p class="tech">{tech.slice(0, 3).join(' · ')}</p>
    {status && status !== 'Completed' && <p class="status">◆ {status}</p>}
    <p class="summary">{summary}</p>

    <div class="actions">
      <a class="btn btn-secondary btn-sm" href={href}>
        Details <span class="visually-hidden">about {title}</span> <PixelIcon name="book" />
      </a>
      {repo && (
        <a class="btn btn-secondary btn-sm" href={repo} rel="noopener noreferrer" target="_blank">
          GitHub <Icon name="github" size={16} /><span class="visually-hidden"> repository for {title} (opens in a new tab)</span>
        </a>
      )}
      {demo && (
        <a class="btn btn-secondary btn-sm" href={demo} rel="noopener noreferrer" target="_blank">
          Demo ▶<span class="visually-hidden"> of {title} (opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    border: 3px solid var(--ink);
    border-radius: 5px;
    box-shadow: inset 0 0 0 3px var(--paper), inset 0 0 0 4px var(--ink), 4px 4px 0 0 var(--ink);
    padding: 0.6rem;
    transition: translate 0.12s steps(2), box-shadow 0.12s steps(2);
  }
  .card:hover, .card:focus-within {
    translate: -2px -2px;
    box-shadow: inset 0 0 0 3px var(--paper), inset 0 0 0 4px var(--ink), 6px 6px 0 0 var(--ink);
  }

  .screen {
    position: relative;
    display: grid;
    place-items: center;
    gap: 0.4rem;
    min-height: 8.5rem;
    padding: 1.6rem 1rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 3px;
    /* Scanlines and the rolling band come from the global .crt class; stagger per card. */
    --crt-delay: calc(var(--i, 0) * -1.9s);
  }
  .bar { position: absolute; top: 0.5rem; left: 0.6rem; display: flex; gap: 4px; }
  .bar i { width: 7px; height: 7px; background: var(--tone-mid); }
  .ctx { font-size: 1rem; color: var(--tone-light); }

  .body { display: flex; flex-direction: column; gap: 0.35rem; flex: 1; padding: 0.9rem 0.5rem 0.4rem; }
  .title { font-size: 1.3rem; margin: 0; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { text-decoration: underline; }
  .tech { margin: 0; font-size: 1rem; color: var(--text-muted); }
  .status { margin: 0; font-size: 1rem; font-weight: 600; }
  .summary { margin: 0.35rem 0 0.75rem; flex: 1; font-size: 1.05rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
