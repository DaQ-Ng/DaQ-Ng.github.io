---
/**
 * A tired software engineer — glasses, eye bags, hoodie, coffee in one hand and a laptop in the other.
 * Shaded pixel art: dark outline, 2–3 tones per colour, light from the left.
 *
 * Each character in the grid is one pixel and maps to a colour in `palette` ("." is transparent).
 * Every row must be the same width. Decorative only: hidden from screen readers.
 */
interface Props {
  /** Size of one sprite pixel, in CSS px. */
  scale?: number;
}
const { scale = 5 } = Astro.props;

const grid = [
  '.........kkkkkkk..........',
  '........kHhhhhHhk.k.......',
  '......kkHHhhhHhhJk.k......',
  '.....kHHHJhhHhhJJHk.......',
  '......kHHHJHhhhhJJk.......',
  '......kHHHHJhhhHJJk.......',
  '......kHHHhhJhhhJJk.......',
  '......kJhhtthJttJJk.......',
  '......khGGGGttGGGGJk......',
  '......ktGgeGGGGgeGkk......',
  '......kSGGGGssGGGG.k......',
  '.......kSbbssnsbbk........',
  '.......kSSsssssttk........',
  '........kkssmmskk.........',
  '..........kkkkk...........',
  '.........kDttttkk.........',
  '.........kDttttFk.........',
  '....kkkkkdwddddwFkkkkk....',
  '...kddkFDdwddddwFFFkddk...',
  '...kddkFDDwddddwFFFkddk...',
  '...kddkFDDwddddwFFFkddk...',
  '...kddkFDDwddddwFFFkddk...',
  '...vddkFDDDddddFFFFkddkkk.',
  '..vkddkFDDDddddFFFFkddkYk.',
  '.v.kddkFDDDddddFFFFkddkYk.',
  '..vkddkFDkkkkkkkkFFkddkYk.',
  '...kddkFDdddFFFFFFFkddkYk.',
  'kkkkkdkFDdddFFFFFFFkddkYk.',
  'kRrXkdkFDdddFFFFFFFksskYk.',
  'kRrXkSkFDdddFFFFFFFksskYk.',
  'kRrXkSkFDDDddddFFFFkkkkYk.',
  'kRrXkkkdddFFFFFFFFFFkYiYk.',
  'kkkkk.kkkkkkkkkkkkkkkYiYk.',
  '........kppQQQQQQk..kYlYk.',
  '........kppQkkQQQk..kYlYk.',
  '........kPPk..kQQk..kYlYk.',
  '........kPPk..kQQk..kYlYk.',
  '........kPPk..kQQk..kkkkk.',
  '........kPPk..kQQk........',
  '........kPPk..kQQk........',
  '........kPPk..kQQk........',
  '........kPPk..kQQk........',
  '........kPPk..kQQk........',
  '........kPPk..kQQk........',
  '.......kkkkk..kkkkk.......',
  '.......kOOOk..koook.......',
  '.......kkkkk..kkkkk.......',
  '..........................',
];

const palette: Record<string, string> = {
  k: '#2b2433', // outline
  H: '#7a5236', // hair light
  h: '#5c3b26', // hair
  J: '#3f2819', // hair shadow
  S: '#f2c9a0', // skin light
  s: '#dba37c', // skin
  t: '#b98060', // skin shadow
  e: '#2b2433', // eyes
  g: '#c9e4ee', // glasses lens glint
  b: '#c99078', // tired eye bags
  m: '#8f4f42', // mouth
  n: '#d39674', // nose shadow
  G: '#2b2433', // glasses frame
  D: '#6f8fa8', // hoodie light
  d: '#55738c', // hoodie
  F: '#3f5670', // hoodie shadow
  w: '#ece6da', // hoodie strings
  P: '#55617a', // jeans light
  p: '#434d63', // jeans
  Q: '#323a4c', // jeans shadow
  O: '#ece6da', // sneakers
  o: '#a49c8e', // soles
  R: '#d8664a', // mug light
  r: '#b04c36', // mug
  X: '#843627', // mug shadow
  v: '#c9c3b8', // steam
  l: '#a5acb8', // laptop
  Y: '#7d8594', // laptop shadow
  i: '#6fb6d9', // laptop logo
};

const width = grid[0].length;
const height = grid.length;
const pixels = grid.flatMap((row, y) =>
  [...row].flatMap((ch, x) => (palette[ch] ? [{ x, y, fill: palette[ch] }] : [])),
);
---

<div class="sprite-wrap">
  <svg
    class="sprite"
    viewBox={`0 0 ${width} ${height}`}
    width={width * scale}
    height={height * scale}
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
  >
    {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} />)}
  </svg>
  <!-- Floating "z z Z": each letter drifts up and fades, staggered. -->
  <span class="zzz" aria-hidden="true"><span>z</span><span>z</span><span>Z</span></span>
</div>

<style>
  .sprite-wrap { position: relative; }
  .sprite { display: block; image-rendering: pixelated; }

  .zzz {
    position: absolute;
    top: -0.75rem;
    right: 0.5rem;
    font-family: var(--font-pixel);
    color: var(--accent);
    pointer-events: none;
  }
  .zzz span { position: absolute; right: 0; top: 0; }
  .zzz span:nth-child(1) { font-size: 0.6rem; }
  .zzz span:nth-child(2) { font-size: 0.85rem; }
  .zzz span:nth-child(3) { font-size: 1.1rem; }

  /* With reduced motion: a static "z z Z" staircase instead of the animation. */
  .zzz span:nth-child(1) { translate: -6px 30px; }
  .zzz span:nth-child(2) { translate: 4px 10px; }
  .zzz span:nth-child(3) { translate: 16px -16px; }

  @keyframes snooze {
    0% { opacity: 0; translate: -6px 34px; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { opacity: 0; translate: 18px -22px; }
  }
  @keyframes nod {
    0%, 70%, 100% { translate: 0 0; }
    80%, 90% { translate: 0 5px; } /* dozes off for a moment… */
  }

  @media (prefers-reduced-motion: no-preference) {
    .sprite { animation: nod 4s steps(1) infinite; }
    .zzz span { animation: snooze 3s steps(8) infinite both; }
    .zzz span:nth-child(2) { animation-delay: 1s; }
    .zzz span:nth-child(3) { animation-delay: 2s; }
  }
</style>
