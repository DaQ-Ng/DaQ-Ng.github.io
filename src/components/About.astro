---
import { site } from '../data/site';
import GameSprite from './GameSprite.astro';
import PixelArt from './PixelArt.astro';
import { tree } from '../game/art';

import PixelIcon from './PixelIcon.astro';

---

<section id="about" class="section container" aria-labelledby="about-title">
  <div class="panel">
    <div class="deco deco-left" aria-hidden="true">
      <PixelArt grid={tree} scale={4} />
    </div>

    <div class="panel-body has-deco grid">
      <div class="text reveal">
        <div class="section-title">
          <PixelIcon name="about" scale={4} />
          <h2 id="about-title">About Me</h2>
        </div>
        {site.about.map((paragraph) => <p>{paragraph}</p>)}
        {site.location && <p class="muted">Based in {site.location}.</p>}

        {site.education.length > 0 && (
          <div class="education">
            <h3 id="education-title"><PixelIcon name="book" scale={3} /> Education</h3>
            {site.education.map((edu) => (
              <div class="edu">
                <p class="school">{edu.school}</p>
                <p>{edu.degree} · {edu.dates}</p>
                {edu.details && <p class="meta">{edu.details}</p>}
              </div>
            ))}
          </div>
        )}
      </div>

      <figure class="portrait reveal" style="--i: 1">
        <GameSprite name="about-portrait" alt={`Pixel-art portrait of ${site.name}`} class="portrait-img" />
        <figcaption>Player 1 · Status: needs coffee</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 52rem) {
    .grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  }
  @media (min-width: 60rem) {
    .grid { padding-right: clamp(1.25rem, 4vw, 2.5rem); }
  }

  .education { margin-top: 1.5rem; }
  .education h3 { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
  .edu { padding-left: 2rem; }
  .edu + .edu { margin-top: 0.85rem; }
  .edu p { margin: 0; }
  .school { font-weight: 600; }
  .meta { color: var(--text-muted); }

  .portrait { margin: 0; display: grid; justify-items: center; gap: 0.75rem; }
  /* The portrait is softly shaded, not on a strict pixel grid, so it scales smoothly:
     "pixelated" scaling at 1.5× doubles some pixels and not others and looks jagged. */
  .portrait :global(.portrait-img) { width: min(100%, 278px); height: auto; image-rendering: auto; }
  figcaption { font-size: 1rem; color: var(--text-muted); }
</style>
