---
import { site } from '../data/site';
import { url } from '../lib/url';
import GameSprite from './GameSprite.astro';

import PixelIcon from './PixelIcon.astro';

// Hash links point at homepage sections, so they also work from project pages.
const links = [
  { href: url(), label: 'Home', icon: 'home' },
  { href: url('#projects'), label: 'Projects', icon: 'projects' },
  { href: url('#about'), label: 'About', icon: 'about' },
  { href: url('#skills'), label: 'Skills', icon: 'skills' },
  { href: url('#contact'), label: 'Contact', icon: 'contact' },
] as const;
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={url()}>
      <span class="avatar"><GameSprite name="avatar" class="avatar-face" /></span>
      {site.name}
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}><PixelIcon name={link.icon} />{link.label}</a></li>
        ))}
        <li>
          <a class="resume" href={url(site.resume)} download><PixelIcon name="download" />Resume</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    --focus: var(--paper);
    background: var(--ink);
    color: var(--paper);
    border-bottom: 3px solid var(--paper);
    box-shadow: 0 3px 0 0 var(--ink);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 4rem;
    padding-block: 0.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--paper);
    text-decoration: none;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: var(--paper);
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--ink);
    overflow: hidden;
  }
  /* Square head crop (public/game/avatar.png), centred and filling the circle. */
  .avatar :global(.avatar-face) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: auto;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--paper);
    text-decoration: none;
  }
  /* Selected menu item: paper pill with an inner ink line, like the mockup's tabs. */
  nav a:hover, nav a:focus-visible {
    background: var(--paper);
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--paper), inset 0 0 0 3px var(--ink);
  }
  nav a:focus-visible { outline-color: var(--paper); }

  /* Small phones: nav on its own row, tighter items so they fit in two rows at most. */
  @media (max-width: 40rem) {
    .site-header { position: static; }
    nav { width: 100%; margin-inline: -0.4rem; }
    nav a { padding: 0.25rem 0.45rem; font-size: 1rem; gap: 0.3rem; }
  }
</style>
