---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="All software engineering projects by Dat Nguyen.">
  <section class="section container" aria-labelledby="all-projects-title">
    <div class="animate-in">
      <span class="section-label">Quest log</span>
      <h1 id="all-projects-title">All projects</h1>
    </div>
    <div class="project-grid">
      {projects.map((project, i) => (
        <div class="reveal" style={`--i: ${i % 3}`}>
          <ProjectCard project={project} headingLevel="h2" />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  h1 { font-size: clamp(1.3rem, 4vw, 2rem); }
  .project-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }
</style>
