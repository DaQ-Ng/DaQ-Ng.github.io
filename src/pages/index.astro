---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { getProjects, getFeaturedProjects } from '../lib/projects';
import { url } from '../lib/url';

const featured = await getFeaturedProjects();
const total = (await getProjects()).length;
---

<BaseLayout>
  <Hero />
  <About />
  <Skills />

  <section id="projects" class="section container" aria-labelledby="projects-title">
    <span class="section-label">Quest log</span>
    <h2 id="projects-title">Featured projects</h2>

    {/* Each card sits in a .reveal wrapper: the wrapper animates in on scroll,
        the card keeps its own hover motion, so the two never fight. */}
    {featured.length > 0 ? (
      <div class="project-grid">
        {featured.map((project, i) => (
          <div class="reveal" style={`--i: ${i % 3}`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    ) : (
      <p class="muted">Projects coming soon.</p>
    )}

    {total > featured.length && (
      <p class="all-link">
        <a class="btn btn-secondary" href={url('projects/')}>See all {total} projects ▶</a>
      </p>
    )}
  </section>

  <Contact />
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }
  .all-link { margin-top: 2.25rem; }
</style>
