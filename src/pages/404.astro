---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found">
  <section class="section container">
    <div class="screen animate-in">
      <p class="over">Game over</p>
      <h1>Page not found</h1>
      <p class="muted">The page you're looking for doesn't exist or has moved.</p>
      <p><a class="btn btn-primary" href={url()}>Continue? ▶</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .screen { text-align: center; padding-block: 2rem 4rem; }
  .over {
    font-family: var(--font-pixel);
    font-size: clamp(1.6rem, 7vw, 3.25rem);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  h1 { font-size: clamp(1rem, 3vw, 1.4rem); }
  .muted { margin-bottom: 2rem; }
</style>
